<policies>
  <inbound>
    <base />
    <!-- Subscription-key auth is enforced by default at the product level.
         Rate limit per subscription to protect the AKS backend and the
         model deployment's TPM quota behind it. -->
    <rate-limit-by-key calls="60" renewal-period="60"
        counter-key="@(context.Subscription?.Id ?? "anonymous")" />
    <set-backend-service base-url="http://<AKS_INTERNAL_LB_IP_OR_HOSTNAME>" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
